# Rekognition Face Liveness (Rider onboarding)
# Confidence values are on a 0..100 scale in Rekognition.
FACE_LIVENESS_MIN_CONFIDENCE=95
FACE_GENDER_MIN_CONFIDENCE=90
# Retry attempts before sending to manual review
# ⚠️ Set to higher value in dev to avoid hitting manual-review wall during testing.
# Reset to 3 (or lower) for production.
