# ─────────────────────────────────────────────
#  Sakhi Backend — Environment Variables
#  Copy this file to .env and fill in values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Rekognition Face Liveness (Rider onboarding)
# Confidence values are on a 0..100 scale in Rekognition.
FACE_LIVENESS_MIN_CONFIDENCE=95
FACE_GENDER_MIN_CONFIDENCE=90
# Retry attempts before sending to manual review
FACE_VERIFICATION_MAX_ATTEMPTS=3

# STS role used to mint short-lived client credentials for Rekognition Streaming.
# This role should be locked down to only allow `rekognitionstreaming:StartFaceLivenessSession`.
FACE_LIVENESS_ROLE_ARN=
# Credential lifetime in seconds (min 900, max 3600)
FACE_LIVENESS_STS_DURATION_SECONDS=900

# Google Services
GOOGLE_MAPS_KEY=
GOOGLE_TRANSLATE_KEY=

# Firebase Admin SDK (JSON string or path to service account file)
FIREBASE_SA_KEY=

# Signzy (KYC / Aadhaar / DL Verification)
SIGNZY_API_KEY=
SIGNZY_WEBHOOK_SECRET=

# Surepass (RC / Vehicle Registration Verification)
# JWT Bearer token — see https://surepass.io/developer/
SUREPASS_TOKEN=

# Exotel (Masked Calling only)
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_APP_ID=

# MSG91 (OTP & SMS)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Google Sheets (Reporting)
SHEETS_CLIENT_EMAIL=
SHEETS_PRIVATE_KEY=
SHEETS_SPREADSHEET_ID=


# Razorpay (Payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX — Nodal account number for instant driver payouts
RAZORPAYX_ACCOUNT_NUMBER=

# Server
PORT=3000
NODE_ENV=development
BASE_URL=https://sakhirides.in

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://sakhirides.in,https://admin.sakhirides.in
