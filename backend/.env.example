# ─────────────────────────────────────────────
#  Sakhi Backend — Environment Variables
#  Copy this file to .env and fill in values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Google Services
GOOGLE_MAPS_KEY=
GOOGLE_TRANSLATE_KEY=

# Firebase Admin SDK (JSON string or path to service account file)
FIREBASE_SA_KEY=

# Signzy (KYC / Aadhaar Verification)
SIGNZY_API_KEY=
SIGNZY_WEBHOOK_SECRET=

# Exotel (Masked Calling)
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_APP_ID=

# Google Sheets (Reporting)
SHEETS_CLIENT_EMAIL=
SHEETS_PRIVATE_KEY=
SHEETS_SPREADSHEET_ID=

# MSG91 (OTP)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Razorpay (Payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server
PORT=3000
NODE_ENV=development
BASE_URL=https://sakhirides.in

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://sakhirides.in,https://admin.sakhirides.in
