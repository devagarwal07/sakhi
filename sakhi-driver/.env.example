# Sakhi Driver App — Environment Variables
# Copy this file to .env.local and fill in your values

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Dev-only: set `true` to bypass OTP + backend auth (UI testing only)
EXPO_PUBLIC_DEV_BYPASS_AUTH=false

# Razorpay public key (safe to expose — used for checkout only)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
