{
  "expo": {
    "name": "sakhi-driver",
    "slug": "sakhi-driver",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1B2E"
    },
    "android": {
      "package": "com.sakhi.partner.driver",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1E1B2E"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Sakhi Driver needs camera access for face verification."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sakhi Driver needs your location to share your position with riders while you are online.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#BEA3D8",
          "defaultChannel": "default",
          "androidMode": "default"
        }
      ],
      "@react-native-firebase/app",
      "./plugins/withAdiRegistration",
      "./plugins/withManifestFixes",
      "./plugins/withRideRequestBridge"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sakhi.partner.driver",
      "buildNumber": "2",
      "appleTeamId": "88KNFT5Y5Z"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3005a6aa-8e10-40d9-acab-9ded139ca4fd"
      }
    },
    "owner": "shubh_up301"
  }
}
