    <!-- ══ Incoming Ride Native UI Activity ══════════════════════════════════
         This is the target of Notifee's fullScreenAction.
         • Transparent theme — appears instantly over lock screen
         • singleTask (NOT singleInstance) — singleInstance breaks fullscreen
           intent on Android 13+, Samsung, Xiaomi, OnePlus (Oxygen OS)
         • showOnLockScreen — required by some OEMs (Samsung, OnePlus)
         • No taskAffinity — required for singleTask to work correctly
    ════════════════════════════════════════════════════════════════════════ -->
    <activity
      android:name=".IncomingRideActivity"
      android:theme="@style/Theme.IncomingRide"
      android:launchMode="singleTask"
      android:exported="true"
      android:showWhenLocked="true"
      android:showOnLockScreen="true"
      android:turnScreenOn="true"
      android:screenOrientation="portrait"
      android:excludeFromRecents="true" />
    <uses-library android:name="org.apache.http.legacy" android:required="false"/>
  </application>
